# --- Supabase ---
# Project URL & anon key are safe to expose to the browser (used for dashboard auth)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used by /api/track and dashboard aggregation routes to bypass RLS safely
# after the app has already verified tenant ownership / site_id validity.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app, used to build the tracker.js <script src>
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Rate limiting (optional but recommended for production) ---
# Upstash Redis REST credentials. If left empty, the app falls back to an
# in-memory limiter that only works correctly on a single instance/process
# (fine for MVP / low traffic, NOT fine for multi-instance production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max ingestion requests allowed per site_id+IP per window (see src/lib/rateLimit.ts)
TRACK_RATE_LIMIT_MAX=120
TRACK_RATE_LIMIT_WINDOW_SECONDS=60
